# 复制为 .env 并填入真实 key（.env 已被 gitignore，不会入库）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 可选：MiniMax TTS（付费，音质更可控）。
# 只有在 config/station.config.json 的 tts.provider 设为 "minimax" 时才需要。
# 切换方式：把 tts.provider 从 "edge-tts" 改成 "minimax"，并填入下面的 key 与 GroupId。
# GroupId 在 MiniMax 控制台「账号管理 > 接口密钥」旁边获取。
MINIMAX_API_KEY=your-minimax-key
MINIMAX_GROUP_ID=your-minimax-group-id